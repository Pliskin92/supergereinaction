; Super Gere: Parise Rescue — Godot 4.3
;
; Engine configuration. Kept deliberately small: anything that belongs to
; the game rather than the engine lives in scripts/config.gd, where it can
; be read and tested, rather than being buried in editor settings.

config_version=5

[application]

config/name="Super Gere: Parise Rescue"
config/description="A 2D side-scrolling beat-em-up."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

; One object, one lifetime, for the run and the settings. See
; scripts/game_state.gd for why these two have deliberately different
; lifetimes.
GameState="*res://scripts/game_state.gd"

[display]

; The design resolution every coordinate in the game is written against.
; The window may be any size; the viewport stretches to it (see stretch
; below), so gameplay code never deals in physical pixels.
window/size/viewport_width=960
window/size/viewport_height=540
; Landscape, matching the game's shape. Enforced on mobile at export.
window/handheld/orientation=1
; canvas_items + expand: scale the whole 2D viewport to the window, and let
; the extra space on an unusual aspect ratio show more of the world rather
; than letterboxing it away.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

; Pixel art: never let the renderer interpolate when scaling sprites.
textures/canvas_textures/default_texture_filter=0
; GL Compatibility renderer targets older Android devices, which is what a
; Play Store release has to survive.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[input_devices]

pointing/emulate_touch_from_mouse=true

