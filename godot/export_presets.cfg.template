; Android export preset, as a template.
;
; The real export_presets.cfg is gitignored because Godot rewrites it with
; machine-local paths and, if you are not careful, the keystore password.
; Copy this to export_presets.cfg and fill in the signing details:
;
;     cp godot/export_presets.cfg.template godot/export_presets.cfg
;
; Then in the editor: Project > Export > Android, and set the release
; keystore and its passwords there rather than committing them.
;
; Before any of this works, the editor needs the Android build template:
;   Editor > Manage Export Templates, and
;   Project > Install Android Build Template
; plus a JDK 17 and the Android SDK, which Godot's Editor Settings can
; point at.

[preset.0]

name="Android"
platform="Android"
runnable=true
advanced_options=true
dedicated_server=false
